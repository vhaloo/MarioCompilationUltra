#include <windows.h>
IDI_MAIN_ICON ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/icon.ico"
1 VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Mario Compilation Ultra"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "ProductName", "Mario Compilation Ultra"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
      VALUE "LegalCopyright", "Independent noncommercial software; see bundled licences"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
